{
  "expo": {
    "name": "poketch",
    "slug": "poketch",
    "scheme": "poketch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/poketch-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jaehyuk.poketch",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_STEPS"
      ],
      "icon": "./assets/poketch-app-icon.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      "expo-image",
      "./plugins/with-local-signing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "658bba76-eb7d-449b-86cc-c9a98aa014d2"
      }
    },
    "owner": "j2h2002",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/658bba76-eb7d-449b-86cc-c9a98aa014d2",
      "requestHeaders": {
        "expo-channel-name": "preview"
      },
      "assetPatternsToBeBundled": [
        "assets/ota/**/*"
      ]
    }
  }
}
